{
  "expo": {
    "name": "IndiaAssist AI",
    "slug": "indiaassist-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "android": {
      "package": "com.yourname.indiaassistai",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0E7490"
      },
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "ios": {
      "bundleIdentifier": "com.yourname.indiaassistai"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "IndiaAssist AI uses your location to detect which state you're in, so it can show you the correct fees and portals for that state."
        }
      ],
      "expo-sharing",
      "expo-status-bar",
      "expo-font",
      [
        "expo-notifications",
        {
          "color": "#0891B2"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "IndiaAssist AI needs access to your photos so you can save document images in your private Document Locker.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "IndiaAssist AI uses Face ID to unlock your private Document Locker."
        }
      ]
    ],
    "extra": {
      "eas": {}
    }
  }
}