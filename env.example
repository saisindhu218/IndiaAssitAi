# Copy this file to .env and fill in your own values.
# Expo automatically exposes any variable prefixed EXPO_PUBLIC_ to the app,
# so NEVER put a secret in an EXPO_PUBLIC_ variable for a build you share.

# --- Firebase (create a free project at https://console.firebase.google.com) ---
EXPO_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
EXPO_PUBLIC_FIREBASE_APP_ID=your_app_id

# --- AI (recommended for anything you share with other people) ---
# URL of your deployed AI proxy (see the /worker folder and worker/README.md).
# The Groq key then stays on the server and is not inside the app.
EXPO_PUBLIC_AI_PROXY_URL=https://indiaassist-ai-proxy.your-subdomain.workers.dev

# --- AI (development only) ---
# Used ONLY when EXPO_PUBLIC_AI_PROXY_URL is empty. This key is visible inside
# the app, so remove it before building something to share.
# Free key: https://console.groq.com/keys
EXPO_PUBLIC_GROQ_API_KEY=
EXPO_PUBLIC_GROQ_MODEL=openai/gpt-oss-120b

# --- Seed script only (not bundled into the app) ---
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
